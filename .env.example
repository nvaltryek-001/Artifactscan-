# ArtifactScan AI configuration. Copy to .env (never commit a real .env).
# All values are optional; defaults are shown.

# Where uploads, thumbnails, reconstructions, exports and the SQLite DB live
# ARTIFACTSCAN_STORAGE=./storage

# Reconstruction engine: auto | colmap | docker | opencv
#   auto = native COLMAP if on PATH, else COLMAP Docker image, else built-in OpenCV SfM
# ARTIFACTSCAN_RECON_ENGINE=auto
# ARTIFACTSCAN_COLMAP_BIN=colmap
# ARTIFACTSCAN_COLMAP_IMAGE=colmap/colmap:latest
# ARTIFACTSCAN_RECON_TIMEOUT=3600

# Upload limits
# ARTIFACTSCAN_MAX_UPLOAD_MB=15
# ARTIFACTSCAN_MAX_FILES=80

# Comma-separated origins allowed to call the API from another site (default: same-origin only)
# ARTIFACTSCAN_CORS_ORIGINS=http://localhost:5173

# Optional ML assets
# ARTIFACTSCAN_DATASET=./data/imet
# ARTIFACTSCAN_MODEL_DIR=./models/classifier
