from __future__ import annotations

import csv
import io
import os
import shutil
import sqlite3
import subprocess
import threading
import uuid
from datetime import datetime, timezone
from pathlib import Path

from fastapi import BackgroundTasks, FastAPI, File, HTTPException, UploadFile
from fastapi.responses import FileResponse, HTMLResponse, StreamingResponse
from fastapi.staticfiles import StaticFiles
from pydantic import BaseModel, Field
from PIL import Image, UnidentifiedImageError

ROOT = Path(__file__).resolve().parent.parent
FRONTEND = ROOT / "frontend"
STORAGE = ROOT / "storage"
UPLOADS = STORAGE / "uploads"
RECON = STORAGE / "reconstructions"
DB = STORAGE / "artifacts.db"

for folder in (UPLOADS, RECON):
    folder.mkdir(parents=True, exist_ok=True)

app = FastAPI(title="ArtifactScan AI", version="0.1.0")
db_lock = threading.Lock()


def now():
    return datetime.now(timezone.utc).isoformat()


def connect():
    con = sqlite3.connect(DB, timeout=15)
    con.row_factory = sqlite3.Row
    return con


def init_db():
    with connect() as con:
        con.executescript("""
        CREATE TABLE IF NOT EXISTS artifacts (
            id TEXT PRIMARY KEY,
            title TEXT NOT NULL,
            category TEXT NOT NULL,
            description TEXT DEFAULT '',
            provenance TEXT DEFAULT '',
            rights TEXT DEFAULT '',
            created_at TEXT NOT NULL
        );
        CREATE TABLE IF NOT EXISTS assets (
            id TEXT PRIMARY KEY,
            artifact_id TEXT NOT NULL,
            filename TEXT NOT NULL,
            path TEXT NOT NULL,
            media_type TEXT NOT NULL,
            checksum TEXT NOT NULL,
            created_at TEXT NOT NULL,
            FOREIGN KEY(artifact_id) REFERENCES artifacts(id)
        );
        CREATE TABLE IF NOT EXISTS jobs (
            id TEXT PRIMARY KEY,
            artifact_id TEXT NOT NULL,
            status TEXT NOT NULL,
            stage TEXT NOT NULL,
            message TEXT DEFAULT '',
            output_dir TEXT DEFAULT '',
            created_at TEXT NOT NULL,
            updated_at TEXT NOT NULL,
            FOREIGN KEY(artifact_id) REFERENCES artifacts(id)
        );
        """)


init_db()


class ArtifactInput(BaseModel):
    title: str = Field(min_length=1, max_length=200)
    category: str = Field(min_length=1, max_length=100)
    description: str = Field(default="", max_length=5000)
    provenance: str = Field(default="", max_length=2000)
    rights: str = Field(default="", max_length=1000)


def artifact_dict(row):
    return dict(row)


def update_job(job_id, status, stage, message="", output_dir=""):
    with connect() as con:
        con.execute(
            """UPDATE jobs SET status=?, stage=?, message=?,
               output_dir=?, updated_at=? WHERE id=?""",
            (status, stage, message[:3000], output_dir, now(), job_id),
        )


@app.get("/api/health")
def health():
    return {"status": "ok", "service": "ArtifactScan AI API"}


@app.get("/api/readiness")
def readiness():
    docker = shutil.which("docker")
    colmap_ready = False
    if docker:
        try:
            check = subprocess.run(
                [docker, "image", "inspect", "colmap/colmap:latest"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=15,
                check=False,
            )
            colmap_ready = check.returncode == 0
        except (subprocess.TimeoutExpired, OSError):
            colmap_ready = False

    return {
        "api": True,
        "database": DB.exists(),
        "colmap": colmap_ready,
        "colmap_runtime": "docker",
        "classifier": False,
        "classifier_note": "No trained model is configured yet.",
    }


@app.get("/api/artifacts")
def list_artifacts():
    with connect() as con:
        rows = con.execute(
            "SELECT * FROM artifacts ORDER BY created_at DESC"
        ).fetchall()
        results = []
        for row in rows:
            item = artifact_dict(row)
            item["image_count"] = con.execute(
                "SELECT COUNT(*) FROM assets WHERE artifact_id=?",
                (item["id"],),
            ).fetchone()[0]
            results.append(item)
    return results


@app.post("/api/artifacts")
def create_artifact(data: ArtifactInput):
    artifact_id = str(uuid.uuid4())
    with connect() as con:
        con.execute(
            """INSERT INTO artifacts
               (id,title,category,description,provenance,rights,created_at)
               VALUES (?,?,?,?,?,?,?)""",
            (
                artifact_id, data.title.strip(), data.category.strip(),
                data.description, data.provenance, data.rights, now()
            ),
        )
    return {"id": artifact_id, "status": "created"}


@app.get("/api/artifacts/{artifact_id}")
def get_artifact(artifact_id: str):
    with connect() as con:
        row = con.execute(
            "SELECT * FROM artifacts WHERE id=?", (artifact_id,)
        ).fetchone()
        if row is None:
            raise HTTPException(404, "Artifact not found")
        item = artifact_dict(row)
        item["assets"] = [
            dict(a) for a in con.execute(
                """SELECT id,filename,media_type,checksum,created_at
                   FROM assets WHERE artifact_id=?""",
                (artifact_id,),
            ).fetchall()
        ]
        item["jobs"] = [
            dict(j) for j in con.execute(
                """SELECT id,status,stage,message,created_at,updated_at
                   FROM jobs WHERE artifact_id=? ORDER BY created_at DESC""",
                (artifact_id,),
            ).fetchall()
        ]
    return item


@app.post("/api/artifacts/{artifact_id}/images")
async def upload_images(
    artifact_id: str,
    files: list[UploadFile] = File(...),
):
    with connect() as con:
        exists = con.execute(
            "SELECT id FROM artifacts WHERE id=?", (artifact_id,)
        ).fetchone()
    if not exists:
        raise HTTPException(404, "Artifact not found")
    if not files or len(files) > 80:
        raise HTTPException(400, "Upload between 1 and 80 images per request")

    target = UPLOADS / artifact_id
    target.mkdir(parents=True, exist_ok=True)
    saved = []

    for upload in files:
        raw = await upload.read()
        if len(raw) > 15 * 1024 * 1024:
            raise HTTPException(413, "Each image must be at most 15 MB")
        try:
            image = Image.open(io.BytesIO(raw))
            image.verify()
        except (UnidentifiedImageError, OSError):
            raise HTTPException(400, "An uploaded file is not a valid image")

        # Reopen after verify and accept only standard image formats.
        image = Image.open(io.BytesIO(raw))
        fmt = (image.format or "").upper()
        extensions = {"JPEG": ".jpg", "PNG": ".png", "WEBP": ".webp"}
        if fmt not in extensions:
            raise HTTPException(400, "Only JPEG, PNG and WEBP images are supported")

        import hashlib
        checksum = hashlib.sha256(raw).hexdigest()
        asset_id = str(uuid.uuid4())
        filename = asset_id + extensions[fmt]
        path = target / filename
        path.write_bytes(raw)

        with connect() as con:
            con.execute(
                """INSERT INTO assets
                   (id,artifact_id,filename,path,media_type,checksum,created_at)
                   VALUES (?,?,?,?,?,?,?)""",
                (
                    asset_id, artifact_id, filename, str(path),
                    upload.content_type or "application/octet-stream",
                    checksum, now()
                ),
            )
        saved.append({"id": asset_id, "filename": filename, "sha256": checksum})

    return {"uploaded": len(saved), "assets": saved}


def run_colmap(job_id: str, image_paths: list[str]):
    import shutil
    import subprocess
    from pathlib import Path

    root = Path("storage/reconstructions").resolve()
    workspace = root / job_id
    images_dir = workspace / "images"
    sparse_dir = workspace / "workspace" / "sparse"
    workspace.mkdir(parents=True, exist_ok=True)
    images_dir.mkdir(parents=True, exist_ok=True)

    # Prepare a clean workspace and copy the source images.
    if images_dir.exists():
        shutil.rmtree(images_dir)
    images_dir.mkdir(parents=True)
    (workspace / "workspace").mkdir(parents=True, exist_ok=True)

    for index, item in enumerate(image_paths):
        src = Path(item)
        if not src.exists():
            raise FileNotFoundError(f"Input image not found: {src}")
        shutil.copy2(src, images_dir / f"image_{index:04d}{src.suffix.lower()}")

    # Convert Windows paths to paths inside the Docker container.
    container_workspace = f"/workspace/{job_id}"
    container_images = f"{container_workspace}/images"
    container_output = f"{container_workspace}/workspace"

    docker_cmd = [
        "docker", "run", "--rm",
        "-v", f"{workspace.resolve()}:/workspace/{job_id}",
        "colmap/colmap:latest",
        "feature_extractor",
        "--database_path", f"{container_output}/database.db",
        "--image_path", container_images,
        "--ImageReader.single_camera", "1",
    ]
    result = subprocess.run(docker_cmd, capture_output=True, text=True)
    if result.returncode != 0:
        raise RuntimeError(
            "COLMAP feature extraction failed.\n"
            + result.stdout[-3000:] + "\n" + result.stderr[-3000:]
        )

    match_cmd = [
        "docker", "run", "--rm",
        "-v", f"{workspace.resolve()}:/workspace/{job_id}",
        "colmap/colmap:latest",
        "exhaustive_matcher",
        "--database_path", f"{container_output}/database.db",
        "--FeatureMatching.use_gpu", "0",
    ]
    result = subprocess.run(match_cmd, capture_output=True, text=True)
    if result.returncode != 0:
        raise RuntimeError(
            "COLMAP feature matching failed.\n"
            + result.stdout[-3000:] + "\n" + result.stderr[-3000:]
        )

    sparse_dir.mkdir(parents=True, exist_ok=True)
    mapper_cmd = [
        "docker", "run", "--rm",
        "-v", f"{workspace.resolve()}:/workspace/{job_id}",
        "colmap/colmap:latest",
        "mapper",
        "--database_path", f"{container_output}/database.db",
        "--image_path", container_images,
        "--output_path", f"{container_output}/sparse",
    ]
    result = subprocess.run(mapper_cmd, capture_output=True, text=True)
    if result.returncode != 0:
        raise RuntimeError(
            "COLMAP sparse mapping failed.\n"
            + result.stdout[-3000:] + "\n" + result.stderr[-3000:]
        )

    models = [
        p for p in sparse_dir.iterdir()
        if p.is_dir() and (
            (p / "points3D.bin").exists() or (p / "points3D.txt").exists()
        )
    ]
    if not models:
        raise RuntimeError(
            "COLMAP did not produce a valid sparse 3D model. "
            "Check image overlap, focus, lighting, and camera movement."
        )

    model = max(
        models,
        key=lambda p: (p / "points3D.bin").stat().st_size
        if (p / "points3D.bin").exists()
        else (p / "points3D.txt").stat().st_size
    )

    model_relative = model.relative_to(workspace / "workspace").as_posix()
    ply_path = workspace / "sparse_point_cloud.ply"
    export_cmd = [
        "docker", "run", "--rm",
        "-v", f"{workspace.resolve()}:/workspace/{job_id}",
        "colmap/colmap:latest",
        "model_converter",
        "--input_path", f"{container_output}/{model_relative}",
        "--output_path", f"{container_workspace}/sparse_point_cloud.ply",
        "--output_type", "PLY",
    ]
    result = subprocess.run(export_cmd, capture_output=True, text=True)
    if result.returncode != 0 or not ply_path.exists() or ply_path.stat().st_size < 100:
        raise RuntimeError(
            "Sparse model was created, but PLY export failed.\n"
            + result.stdout[-3000:] + "\n" + result.stderr[-3000:]
        )

    print(f"Sparse reconstruction exported: {ply_path}")
    return str(ply_path)
def run_reconstruction_job(job_id: str, artifact_id: str):
    from pathlib import Path

    try:
        with connect() as con:
            rows = con.execute(
                "SELECT path FROM assets WHERE artifact_id=? ORDER BY created_at",
                (artifact_id,),
            ).fetchall()

        image_paths = [row["path"] for row in rows]
        if len(image_paths) < 3:
            raise RuntimeError(
                f"Only {len(image_paths)} image paths found; at least 3 are required."
            )

        update_job(
            job_id, "running", "photogrammetry",
            f"Starting sparse reconstruction with {len(image_paths)} images."
        )

        output_path = run_colmap(job_id, image_paths)
        output_file = Path(output_path)

        if not output_file.is_file() or output_file.stat().st_size < 100:
            raise RuntimeError("Reconstruction finished without a valid PLY output.")

        update_job(
            job_id, "completed", "completed",
            f"Sparse point cloud exported: {output_file}",
            str(output_file.parent),
        )

    except Exception as exc:
        update_job(
            job_id, "failed", "photogrammetry",
            f"{type(exc).__name__}: {exc}",
        )
        print(f"Reconstruction job {job_id} failed: {exc}")


@app.post("/api/artifacts/{artifact_id}/reconstructions")
def start_reconstruction(artifact_id: str, background_tasks: BackgroundTasks):
    with connect() as con:
        exists = con.execute(
            "SELECT id FROM artifacts WHERE id=?", (artifact_id,)
        ).fetchone()
        count = con.execute(
            "SELECT COUNT(*) FROM assets WHERE artifact_id=?",
            (artifact_id,),
        ).fetchone()[0]

        if not exists:
            raise HTTPException(404, "Artifact not found")
        if count < 3:
            raise HTTPException(
                400, "Upload at least 3 valid photographs before reconstruction"
            )

        job_id = str(uuid.uuid4())
        con.execute(
            """INSERT INTO jobs
               (id,artifact_id,status,stage,message,created_at,updated_at)
               VALUES (?,?,?,?,?,?,?)""",
            (
                job_id, artifact_id, "queued", "queued",
                "Waiting for reconstruction worker.", now(), now()
            ),
        )

    background_tasks.add_task(run_reconstruction_job, job_id, artifact_id)
    return {"job_id": job_id, "status": "queued"}


@app.get("/api/jobs/{job_id}")
def get_job(job_id: str):
    with connect() as con:
        row = con.execute(
            "SELECT * FROM jobs WHERE id=?", (job_id,)
        ).fetchone()
    if not row:
        raise HTTPException(404, "Job not found")
    return dict(row)


@app.get("/api/artifacts/{artifact_id}/classification")
def classification_status(artifact_id: str):
    with connect() as con:
        exists = con.execute(
            "SELECT id FROM artifacts WHERE id=?", (artifact_id,)
        ).fetchone()
    if not exists:
        raise HTTPException(404, "Artifact not found")
    return {
        "status": "unavailable",
        "message": "No trained classifier is installed. No prediction was fabricated.",
    }


@app.get("/api/reports/artifacts.csv")
def export_artifacts():
    with connect() as con:
        rows = con.execute(
            "SELECT * FROM artifacts ORDER BY created_at DESC"
        ).fetchall()
    stream = io.StringIO()
    fields = [
        "id", "title", "category", "description",
        "provenance", "rights", "created_at"
    ]
    writer = csv.DictWriter(stream, fieldnames=fields)
    writer.writeheader()
    for row in rows:
        writer.writerow(dict(row))
    stream.seek(0)
    return StreamingResponse(
        iter([stream.getvalue()]),
        media_type="text/csv",
        headers={"Content-Disposition": "attachment; filename=artifacts.csv"},
    )



DATASET_ROOT = ROOT / "data" / "imet"
DATASET_SPLITS = {"train", "validation"}


@app.get("/api/dataset")
def list_dataset(split: str = "train", limit: int = 60, offset: int = 0):
    import csv

    if split not in DATASET_SPLITS:
        raise HTTPException(400, "split must be train or validation")
    if limit < 1 or limit > 100:
        raise HTTPException(400, "limit must be between 1 and 100")
    if offset < 0:
        raise HTTPException(400, "offset must be non-negative")

    metadata = DATASET_ROOT / f"{split}_metadata.csv"
    images_dir = DATASET_ROOT / split
    if not metadata.is_file() or not images_dir.is_dir():
        raise HTTPException(503, "Dataset files are not installed")

    with metadata.open("r", encoding="utf-8", newline="") as f:
        rows = list(csv.DictReader(f))

    items = []
    for row in rows:
        filename = row.get("filename", "")
        image_path = images_dir / filename
        if not filename or not image_path.is_file():
            continue
        items.append({
            "filename": filename,
            "title": row.get("title", ""),
            "label": row.get("label_name", ""),
            "object_id": row.get("object_id", ""),
            "object_url": row.get("object_url", ""),
            "image_url": f"/api/dataset/images/{split}/{filename}",
        })

    return {
        "source": "The Metropolitan Museum of Art — iMet Open Access subset",
        "split": split,
        "total": len(items),
        "offset": offset,
        "limit": limit,
        "items": items[offset:offset + limit],
    }


@app.get("/api/dataset/images/{split}/{filename}")
def dataset_image(split: str, filename: str):
    import re

    if split not in DATASET_SPLITS:
        raise HTTPException(400, "Invalid dataset split")
    if not re.fullmatch(r"[A-Za-z0-9_-]+\.jpg", filename):
        raise HTTPException(400, "Invalid image filename")

    path = DATASET_ROOT / split / filename
    if not path.is_file():
        raise HTTPException(404, "Dataset image not found")
    return FileResponse(path, media_type="image/jpeg")


@app.get("/", response_class=HTMLResponse)
def index():
    page = FRONTEND / "index.html"
    if not page.exists():
        raise HTTPException(500, "Frontend file is missing")
    return page.read_text(encoding="utf-8")


app.mount("/static", StaticFiles(directory=FRONTEND / "static"), name="static")

