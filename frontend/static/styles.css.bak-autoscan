@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap');

:root {
  --bg:#f4f7fb; --surface:#fff; --ink:#152743; --muted:#71809a;
  --line:#e5eaf2; --gold:#ad741d; --gold-light:#f8eddb;
  --blue:#397cf6; --green:#21a77a; --orange:#ed8a38; --purple:#9860ec;
  --shadow:0 5px 22px rgba(25,47,82,.045); --radius:17px;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:'DM Sans',sans-serif;font-size:14px}
button,input,textarea,select{font:inherit}
button{cursor:pointer}
button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #8bb7ff;outline-offset:2px}
.app-shell{min-height:100vh;display:grid;grid-template-columns:248px minmax(0,1fr)}
.sidebar{position:sticky;top:0;height:100vh;background:#fff;border-right:1px solid var(--line);padding:24px 13px;display:flex;flex-direction:column;z-index:10}
.brand{display:flex;align-items:center;gap:10px;padding:0 8px 27px;color:inherit;text-decoration:none}
.brand-mark{font-size:38px;color:var(--gold);line-height:1}
.brand strong{font-family:'Playfair Display',serif;font-size:17px;white-space:nowrap}
.brand i{color:var(--gold);font-style:normal}
.brand small{display:block;color:var(--muted);font-size:10px;margin-top:5px}
.nav-label,.eyebrow{font-size:10px;letter-spacing:1.7px;color:#9a794b;font-weight:700}
.nav-label{padding:12px 12px}
#mainNav{display:grid;gap:5px}
.nav-item{border:0;background:transparent;color:#465a76;border-radius:10px;text-align:left;padding:12px 13px;display:flex;align-items:center;gap:13px;font-size:13px;transition:.2s}
.nav-item span{width:22px;font-size:19px;text-align:center}
.nav-item:hover{background:#f7f4ef}
.nav-item.active{background:var(--gold-light);color:#875615;font-weight:700;box-shadow:inset 3px 0 #d8a14e}
.sidebar-art{margin-top:auto;border-radius:14px;padding:18px 15px;background:linear-gradient(150deg,#fffaf0,#f1e4cf);min-height:175px;display:flex;flex-direction:column;justify-content:flex-end;overflow:hidden;position:relative}
.sidebar-art:before{content:'⌂';position:absolute;right:-3px;top:-42px;font-size:150px;color:rgba(166,115,40,.12)}
.temple-symbol{font-size:34px;color:#b98539}
.sidebar-art p{font-family:'Playfair Display',serif;font-size:18px;margin:9px 0}
.sidebar-art small{line-height:1.6;color:#766b5d}
.sidebar-bottom{padding:17px 5px 0;color:var(--muted);font-size:11px}
.online-dot,.status-dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--green);flex-shrink:0}
.sidebar-bottom .online-dot{margin-right:7px}
.main-area{min-width:0}
.topbar{height:68px;position:sticky;top:0;z-index:8;background:rgba(255,255,255,.92);backdrop-filter:blur(16px);border-bottom:1px solid var(--line);display:flex;align-items:center;gap:18px;padding:0 27px}
.search-box{height:41px;max-width:560px;width:100%;display:flex;align-items:center;gap:10px;border:1px solid #e1e7f0;border-radius:11px;background:#f8fafd;padding:0 13px;color:#71809a}
.search-box>span{font-size:24px}
.search-box input{border:0;outline:none;background:transparent;width:100%;min-width:0;color:var(--ink);font-size:12px}
kbd{font-size:10px;border:1px solid #e1e7f0;background:#fff;border-radius:5px;padding:3px 5px;white-space:nowrap}
.top-actions{margin-left:auto;display:flex;align-items:center;gap:12px}
.api-pill{display:flex;align-items:center;gap:8px;border:1px solid var(--line);background:#fff;padding:10px 14px;border-radius:22px;font-size:11px;white-space:nowrap}
.icon-button,.mobile-menu{width:36px;height:36px;border:1px solid var(--line);border-radius:10px;background:white;color:var(--ink)}
.mobile-menu{display:none}
.page-content{padding:18px 22px 12px;max-width:1800px;margin:auto}
.welcome-row{display:grid;grid-template-columns:minmax(0,1.75fr) minmax(300px,.85fr);gap:14px}
.hero{min-height:282px;border:1px solid #e8e6df;border-radius:var(--radius);overflow:hidden;position:relative;background:linear-gradient(100deg,#fffdf9 0%,#fbf7f0 47%,#d5c4a9 100%);display:flex}
.hero-copy{position:relative;z-index:2;width:63%;padding:27px 24px}
.hero h1{font-family:'Playfair Display',serif;font-size:clamp(34px,3.1vw,51px);line-height:1.07;letter-spacing:-1.2px;margin:12px 0;color:#142a45}
.hero h1 span{color:var(--gold)}
.hero-copy>p{font-size:13px;line-height:1.7;max-width:400px;color:#52617a;margin:13px 0 17px}
.hero-actions{display:flex;gap:9px;flex-wrap:wrap}
.btn{border-radius:9px;padding:11px 15px;font-size:12px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;gap:7px;border:1px solid transparent;transition:transform .15s,box-shadow .15s}
.btn:hover,.quick-action:hover{transform:translateY(-1px);box-shadow:0 5px 15px rgba(20,42,69,.08)}
.btn-gold{background:linear-gradient(110deg,#a66b16,#c18a35);color:#fff}
.btn-outline{background:#fff;border-color:#dce3ee;color:#23436d}
.btn-navy{background:#172d49;color:white}
.btn-small{padding:8px 10px}
.hero-note{font-size:10px;color:#6c7a8d;margin-top:17px;display:flex;align-items:center;gap:7px}
.hero-art{position:absolute;right:0;top:0;height:100%;width:47%;overflow:hidden;clip-path:polygon(17% 0,100% 0,100% 100%,0 100%)}
.hero-art:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#fbf7f0 0%,rgba(251,247,240,.2) 32%,transparent 75%)}
.hero-art img{width:100%;height:100%;object-fit:cover;object-position:center}
.hero-art-caption{position:absolute;z-index:1;right:14px;bottom:13px;font-family:'Playfair Display',serif;font-style:italic;color:#fff;font-size:11px;line-height:1.6;text-align:right;text-shadow:0 2px 7px #4c351c}
.panel,.stat-card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);min-width:0}
.readiness{padding:19px 17px;display:flex;flex-direction:column}
.section-heading{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:15px}
.section-heading h2{font-size:16px;letter-spacing:-.35px;margin:5px 0 0}
.text-button{border:0;background:transparent;color:#2868cb;font-size:11px;font-weight:600;white-space:nowrap}
.system-list{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.system-card{min-width:0;display:flex;align-items:center;gap:9px;padding:12px 9px;border:1px solid #edf0f5;border-radius:12px;background:#fcfdff}
.system-icon,.stat-icon,.quick-icon{width:39px;height:39px;display:grid;place-items:center;border-radius:12px;font-size:20px;flex-shrink:0}
.system-icon.green,.stat-icon.green,.quick-icon.green{background:#e3f7ef;color:#1ca47a}
.system-icon.blue,.stat-icon.blue,.quick-icon.blue{background:#eaf1ff;color:#397cf6}
.system-icon.orange,.stat-icon.orange,.quick-icon.orange{background:#fff2e4;color:#ed852e}
.system-icon.purple,.stat-icon.purple,.quick-icon.purple{background:#f4eaff;color:#9857e9}
.system-card>div{min-width:0;flex:1}
.system-card strong{font-size:11px;display:block}
.system-card small{font-size:10px;display:block;margin-top:6px;color:var(--muted);overflow-wrap:anywhere}
.system-card small.ok{color:#17966e}
.system-card small.warn{color:#c17c23}
.system-card .status-dot{width:7px;height:7px}
.status-dot.warn{background:#e6a03e}
.status-dot.off{background:#c6ceda}
.panel-foot{margin:auto 0 0;padding-top:13px;color:var(--muted);font-size:10px;line-height:1.5}
.stats-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:13px}
.stat-card{padding:16px;display:flex;align-items:center;gap:12px;position:relative;overflow:hidden}
.stat-icon{width:48px;height:48px;font-size:25px}
.stat-card>div{min-width:0}
.stat-card small{font-size:11px;color:var(--muted)}
.stat-card strong{display:block;font-size:27px;letter-spacing:-1px;margin:4px 0}
.stat-card p{margin:0;color:#7c8ba0;font-size:10px}
.stat-decoration{position:absolute;right:12px;top:11px;font-size:10px;letter-spacing:1px;color:#c8d2e1}
.content-grid{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(235px,.95fr) minmax(220px,.85fr);gap:12px;margin-top:13px}
.collection-panel,.distribution-panel,.quick-panel,.reconstruction-panel,.activity-panel{padding:17px}
.filter-row{display:flex;justify-content:space-between;align-items:center;gap:10px;color:var(--muted);font-size:10px;margin:-3px 0 12px}
.artifact-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}
.artifact-card{border:1px solid #edf0f5;border-radius:10px;overflow:hidden;min-width:0;background:#fff}
.artifact-card img{width:100%;height:103px;object-fit:cover;background:#f0e8dc;display:block}
.artifact-card .artifact-info{padding:8px}
.artifact-card strong{font-size:10px;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.artifact-card small{display:block;color:var(--muted);font-size:9px;margin-top:5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.artifact-card .artifact-id{color:#9a7a4a}
.empty-state{grid-column:1/-1;padding:25px 10px;text-align:center;color:var(--muted);font-size:12px;line-height:1.7;border:1px dashed #dfe5ef;border-radius:10px}
.category-chart{display:flex;align-items:center;gap:15px;min-height:185px}
.donut{width:128px;height:128px;border-radius:50%;position:relative;flex-shrink:0;display:grid;place-items:center;background:conic-gradient(#4386fa 0 25%,#f16e72 25% 50%,#ffc66c 50% 70%,#48c6a0 70% 100%)}
.donut:after{content:'';position:absolute;inset:22px;border-radius:50%;background:#fff}
.donut-center{z-index:1;text-align:center;position:relative}
.donut-center strong{display:block;font-size:23px}
.donut-center small{font-size:10px;color:var(--muted)}
.legend{display:grid;gap:12px;flex:1;min-width:0}
.legend-row{display:grid;grid-template-columns:8px minmax(0,1fr) auto;align-items:center;gap:7px;font-size:10px;color:#687992}
.legend-dot{width:8px;height:8px;border-radius:50%}
.legend-row strong{color:#233650;font-size:10px}
.chart-note{color:#98a4b5;font-size:9px;margin:8px 0 0}
.quick-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.quick-action{min-height:90px;border:1px solid #edf0f5;border-radius:12px;background:#fffaf3;display:flex;flex-direction:column;align-items:flex-start;text-align:left;padding:11px;gap:5px;transition:.2s}
.quick-action:nth-child(2){background:#f5f8ff}
.quick-action:nth-child(3){background:#fff8ef}
.quick-action:nth-child(4){background:#faf5ff}
.quick-icon{width:31px;height:31px;font-size:21px;background:#fff}
.quick-icon.gold{color:var(--gold);background:#fff0d7}
.quick-action strong{font-size:10px}
.quick-action small{font-size:9px;color:var(--muted)}
.bottom-grid{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(270px,.85fr);gap:12px;margin-top:13px}
.soft-badge{background:#f5f0e7;color:#96703a;padding:6px 10px;border-radius:8px;font-size:10px}
.reconstruction-layout{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(185px,.7fr);gap:13px}
.model-viewer{min-width:0;background:#101e2b;border-radius:12px;padding:10px;color:white;display:flex;flex-direction:column;min-height:260px}
.viewer-top,.viewer-bottom{display:flex;justify-content:space-between;gap:8px;font-size:9px;color:#aebdd0}
.viewer-top{padding:2px 2px 9px}
.viewer-bottom{padding:10px 2px 2px}
.viewer-bottom span:last-child{text-align:right;max-width:65%}
.model-placeholder{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;background-image:linear-gradient(rgba(106,139,168,.07) 1px,transparent 1px),linear-gradient(90deg,rgba(106,139,168,.07) 1px,transparent 1px);background-size:24px 24px;border:1px solid #2c4053;border-radius:8px;padding:20px}
.wire-cube{font-size:57px;color:#d3b47b;line-height:1.1}
.model-placeholder strong{font-size:12px;margin-top:10px}
.model-placeholder p{font-size:10px;color:#9eafc2;max-width:260px;line-height:1.6}
.reconstruction-controls{display:flex;flex-direction:column;align-items:stretch;gap:9px}
.reconstruction-controls label,.register-dialog label{font-size:11px;font-weight:700;color:#4a5d77}
.reconstruction-controls select,.reconstruction-controls input[type=file]{width:100%;min-width:0;border:1px solid #dfe6f0;border-radius:9px;background:#fff;padding:10px;font-size:10px;color:#4a5d77}
.reconstruction-controls input[type=file]{padding:8px;font-size:9px}
.helper{font-size:10px;color:var(--muted);line-height:1.5}
.full-width{width:100%}
.job-message{font-size:10px;line-height:1.6;color:#74839a;background:#f7f9fc;padding:10px;border-radius:9px;overflow-wrap:anywhere}
.job-message.error{color:#b33a36;background:#fff0ef}
.job-message.success{color:#16845e;background:#eaf8f1}
.activity-item{display:flex;align-items:flex-start;gap:11px;padding:13px 0;border-bottom:1px solid #eff2f6}
.activity-marker{width:29px;height:29px;display:grid;place-items:center;border-radius:50%;flex-shrink:0;font-weight:700}
.activity-marker.green{background:#e4f8ef;color:#19a274}
.activity-marker.blue{background:#eaf1ff;color:#397cf6}
.activity-marker.orange{background:#fff0df;color:#e8862e}
.activity-marker.purple{background:#f3eaff;color:#9655e9}
.activity-item strong{font-size:11px}
.activity-item p{margin:5px 0 0;color:var(--muted);font-size:10px;line-height:1.5}
.activity-footer{padding-top:15px;font-size:10px;color:var(--muted);display:flex;align-items:center;gap:7px}
.footer{display:flex;justify-content:space-between;gap:12px;padding:18px 3px 7px;color:#98a4b5;font-size:9px}
.footer span:first-child{color:#6f7e93;font-weight:700}
.inline-message{font-size:11px;color:var(--muted);margin-top:8px;line-height:1.5}
.register-dialog{border:1px solid var(--line);border-radius:18px;width:min(480px,calc(100% - 30px));padding:24px;box-shadow:0 20px 80px #10213b35}
.register-dialog::backdrop{background:#14243b66;backdrop-filter:blur(3px)}
.register-dialog form{display:grid;gap:12px}
.dialog-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:5px}
.dialog-heading h2{margin:6px 0;font-size:21px}
.register-dialog input,.register-dialog textarea{width:100%;border:1px solid #dfe6f0;border-radius:9px;padding:11px;resize:vertical}
.form-note{font-size:10px;color:var(--muted);line-height:1.6}
.dialog-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:5px}
@media(min-width:1500px){.page-content{padding:22px 28px}.hero{min-height:300px}.artifact-card img{height:125px}}
@media(max-width:1200px){.app-shell{grid-template-columns:220px minmax(0,1fr)}.content-grid{grid-template-columns:minmax(0,1.4fr) minmax(230px,.9fr)}.quick-panel{grid-column:1/-1}.quick-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.hero-copy{width:68%}.hero-art{width:43%}.stats-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:850px){.app-shell{grid-template-columns:1fr}.sidebar{position:fixed;left:-270px;width:250px;box-shadow:0 15px 40px #15274320;transition:left .2s}.sidebar.open{left:0}.mobile-menu{display:block}.topbar{padding:0 14px;gap:10px}.page-content{padding:13px}.welcome-row{grid-template-columns:1fr}.hero{min-height:280px}.readiness{padding:16px}.content-grid{grid-template-columns:1fr 1fr}.collection-panel{grid-column:1/-1}.quick-panel{grid-column:auto}.bottom-grid{grid-template-columns:1fr}.hero-copy{width:68%}}
@media(max-width:560px){.topbar{height:59px}.search-box{height:37px}.search-box kbd{display:none}.api-pill{padding:9px;font-size:0}.api-pill .online-dot{width:9px;height:9px}.top-actions{gap:6px}.page-content{padding:9px}.hero{min-height:325px}.hero-copy{width:100%;padding:22px 18px}.hero h1{font-size:39px}.hero-art{width:56%;opacity:.26;clip-path:none}.hero-art:after{background:linear-gradient(90deg,#fbf7f0 0%,transparent 100%)}.hero-copy>p{max-width:310px}.stats-grid{gap:8px}.stat-card{padding:12px 9px;gap:8px}.stat-icon{width:36px;height:36px;font-size:20px}.stat-card strong{font-size:22px}.stat-card small{font-size:10px}.stat-card p{font-size:9px}.stat-decoration{display:none}.content-grid{grid-template-columns:1fr}.collection-panel,.quick-panel{grid-column:auto}.artifact-card img{height:100px}.quick-grid{grid-template-columns:1fr 1fr}.reconstruction-layout{grid-template-columns:1fr}.model-viewer{min-height:245px}.category-chart{justify-content:center}.footer{flex-wrap:wrap}.system-card{padding:10px 7px;gap:7px}.system-icon{width:32px;height:32px}.system-card strong{font-size:10px}.system-card small{font-size:9px}}
